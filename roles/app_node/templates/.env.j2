# Dynamically generated by Ansible
APP_NAME={{ app_name }}
# Automatically constructs the Postgres connection string pointing to your db_node!
DATABASE_URL=postgres://{{ app_name }}:{{ db_password | default('change_me_in_vault') }}@{{ hostvars[groups['db_nodes'][0]]['ansible_host'] | default('localhost') }}:5432/{{ app_name }}
