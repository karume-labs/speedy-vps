#!/bin/bash
# Restore script for {{ app_name }}

if [ -z "$1" ]; then
    echo "Usage: ./db_restore.sh <path_to_backup_file.sql.gz>"
    exit 1
fi

BACKUP_FILE=$1

if [ ! -f "$BACKUP_FILE" ]; then
    echo "Error: File $BACKUP_FILE does not exist."
    exit 1
fi

echo "WARNING: This will overwrite the current database '{{ app_name }}'."
read -p "Are you sure you want to continue? (y/N): " confirm

if [[ "$confirm" != [yY] && "$confirm" != [yY][eE][sS] ]]; then
    echo "Restore cancelled."
    exit 0
fi

echo "Restoring database {{ app_name }} from $BACKUP_FILE..."

# Decompress and execute against the database
zcat "$BACKUP_FILE" | sudo -u postgres psql {{ app_name }}

echo "Restore complete!"
